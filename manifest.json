{
  "manifest_version": 3,
  "name": "Kyara Booster Helper",
  "version": "1.1.5",
  "description": "Repère les boosters gratuits et reprend les étapes même lorsque l'onglet Kyara est en arrière-plan.",
  "permissions": ["storage", "alarms", "tabs", "scripting", "notifications"],
  "host_permissions": ["https://kyara.games/*", "https://www.kyara.games/*", "https://api.github.com/*"],
  "background": { "service_worker": "background.js" },
  "icons": { "128": "icon128.png" },
  "action": { "default_title": "Kyara Booster Helper", "default_popup": "popup.html" },
  "content_scripts": [{
    "matches": ["https://kyara.games/*", "https://www.kyara.games/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
